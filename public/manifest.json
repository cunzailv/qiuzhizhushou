{
  "manifest_version": 3,
  "name": "智能求职助手",
  "version": "1.2.0",
  "description": "多平台智能求职助手：覆盖 Boss直聘/猎聘/智联招聘/前程无忧/脉脉，AI 匹配评分、Tool-Calling 中控 Agent、精投/海投自动投递与目标必达",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "打开求职助手侧栏",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "src/options/index.html",
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.zhipin.com/*",
        "https://zhipin.com/*",
        "*://*.liepin.com/*",
        "*://liepin.com/*",
        "*://*.51job.com/*",
        "*://51job.com/*",
        "*://*.zhaopin.com/*",
        "*://zhaopin.com/*",
        "*://*.maimai.cn/*",
        "*://maimai.cn/*"
      ],
      "js": ["src/content/index.ts"],
      "run_at": "document_end"
    }
  ],
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "tabs",
    "scripting",
    "cookies",
    "offscreen"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://api.deepseek.com/*",
    "https://*.deepseek.com/*",
    "https://api.openai.com/*",
    "https://*.openai.com/*",
    "https://dashscope.aliyuncs.com/*",
    "https://api.moonshot.cn/*",
    "https://open.bigmodel.cn/*",
    "https://www.zhipin.com/*",
    "https://zhipin.com/*",
    "*://*.liepin.com/*",
    "*://liepin.com/*",
    "*://*.51job.com/*",
    "*://51job.com/*",
    "*://*.zhaopin.com/*",
    "*://zhaopin.com/*",
    "*://*.maimai.cn/*",
    "*://maimai.cn/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/assets/*", "src/popup/index.html", "assets/*"],
      "matches": [
        "https://www.zhipin.com/*",
        "https://zhipin.com/*",
        "*://*.liepin.com/*",
        "*://liepin.com/*",
        "*://*.51job.com/*",
        "*://51job.com/*",
        "*://*.zhaopin.com/*",
        "*://zhaopin.com/*",
        "*://*.maimai.cn/*",
        "*://maimai.cn/*"
      ]
    }
  ]
}
